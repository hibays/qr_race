[package]
name = "cvlite"
description = "Rust port of the OpenCV imgproc functions resize, adaptiveThreshold, cvtColor and blobFromImage, with no dependencies and NEON paths on aarch64"
keywords = ["opencv", "imgproc", "resize", "image", "simd"]
categories = ["computer-vision", "multimedia::images", "algorithms"]
version = "0.1.0"
edition = "2021"
license = "Apache-2.0"
repository = "https://github.com/wilinz/cvlite"
rust-version = "1.75"
readme = "README.md"
# The parity fixtures are dev-only and regenerated by tools/gen_reference.py.
exclude = ["tests/**", "tools/**"]

[dependencies]

[dev-dependencies]
image = { version = "0.25", default-features = false, features = ["png", "jpeg"] }

[profile.release]
opt-level = 3
